# VPark - Environment Configuration Template
NODE_ENV=development
PORT=3000

# Firebase Client Configuration (Optional / Client-side Google Sign-In)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps JavaScript API (optional; used by the Digital Pass location map)
# - With a key: a real Google map that follows VPark's light/dark theme.
# - Without a key: the keyless Google Maps iframe, which cannot be styled or shown in dark mode.
# This key is exposed to the browser. In Google Cloud, restrict it by HTTP referrer
# (your production domain and http://localhost:3000/*) and to the "Maps JavaScript API" only.
# Do not set a Map ID: JSON map styles are ignored when a Map ID is used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Server-side security configuration (see docs/SECURITY.md)
# Never commit real values. Set them in .env.local locally and in the Vercel
# project settings (Production + Preview) for deployments.
# ---------------------------------------------------------------------------

# REQUIRED in production. Key used to HMAC session tokens in the session store.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset in development, a random per-process key is used (sessions reset on restart).
# Changing it signs every user out.
SESSION_SECRET=

# REQUIRED in production: durable, shared session store (Redis via the Upstash REST API).
# In Vercel: Storage / Marketplace > Upstash Redis > connect to this project; it sets these for you.
# The URL must be https://. The token is a SECRET: never commit it or expose it as NEXT_PUBLIC_*.
# Vercel KV names (KV_REST_API_URL / KV_REST_API_TOKEN) are accepted instead. The read-only token is never used.
# If these are missing in production, sessions are disabled and sign-in returns HTTP 503 (fail closed);
# local files and process memory are never used for production sessions.
# Leave empty for local development to use the local development store in ./.data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: key namespace in Redis. Use different prefixes (or separate databases) for Production and Preview.
# VPARK_SESSION_KEY_PREFIX=vpark:session:

# Optional: set to "redis" outside production to require Redis instead of the local development store.
# VPARK_SESSION_STORE=redis

# REQUIRED for Google sign-in. The Firebase project whose ID tokens the server accepts.
# Usually identical to NEXT_PUBLIC_FIREBASE_PROJECT_ID (it is a public identifier, not a credential).
# If neither is set, /api/auth/google fails closed with HTTP 503.
FIREBASE_PROJECT_ID=

# Comma-separated Firebase Authentication UIDs that are granted ADMIN.
# Admin access is never granted by email address or by anything the browser sends.
# Find a UID in Firebase Console > Authentication > Users. Leave empty for no admins.
VPARK_ADMIN_FIREBASE_UIDS=

# Optional: directory for the JSON/SQLite data store (defaults to ./.data). Used by the test suite.
# VPARK_DATA_DIR=

# Never set FIREBASE_AUTH_EMULATOR_HOST outside local emulator testing: the Admin SDK skips
# token signature checks when it is set, so the server refuses Google sign-in in production if it is.
